{
  "name": "startup-sentry",
  "version": "1.0.0",
  "description": "Free & open-source Windows startup program manager",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "test": "jest"
  },
  "build": {
    "appId": "com.startup-sentry",
    "productName": "Startup Sentry",
    "win": {
      "target": "portable",
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "requireAdministrator",
      "artifactName": "StartupSentry-${version}.exe"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "node_modules/electron-store/**/*",
      "node_modules/conf/**/*",
      "node_modules/atomically/**/*",
      "node_modules/dot-prop/**/*",
      "node_modules/env-paths/**/*",
      "node_modules/json-schema-typed/**/*",
      "node_modules/ajv/**/*",
      "node_modules/ajv-formats/**/*",
      "node_modules/fast-deep-equal/**/*",
      "node_modules/json-schema-traverse/**/*",
      "node_modules/uri-js/**/*",
      "node_modules/punycode/**/*",
      "node_modules/semver/**/*",
      "node_modules/debounce-fn/**/*",
      "node_modules/mimic-fn/**/*",
      "node_modules/type-fest/**/*"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Nimba-Solutions/Startup-Sentry.git"
  },
  "author": "Cloud Nimbus LLC",
  "license": "BSL-1.1",
  "dependencies": {
    "electron-store": "^8.1.0"
  },
  "devDependencies": {
    "@jest/globals": "^30.3.0",
    "electron": "^28.0.0",
    "electron-builder": "^26.8.1",
    "jest": "^30.3.0"
  }
}
